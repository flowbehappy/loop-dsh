{
  "name": "@pingkai/loop-dsh",
  "version": "2.0.0",
  "description": "Unified DeepSeek Harness host runtime bridge and OAuth bootstrap plugin for Loop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "loop-dsh": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills/loop-dsh/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dependencies": {
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && npm run build",
    "pretest": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test-build/test/*.test.js"
  }
}
