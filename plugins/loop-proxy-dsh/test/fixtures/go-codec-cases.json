      "rawInput": "{\"z\":\"<>&\\u2028\\u2029\",\"a\":{\"2\":\"two\",\"10\":\"ten\"},\"sequence\":7}",
      "goOutput": "{\"a\":{\"10\":\"ten\",\"2\":\"two\"},\"sequence\":7,\"z\":\"\\u003c\\u003e\\u0026\\u2028\\u2029\"}"
    },
    {
      "id": "lossless-number-lexemes",
      "entryDecoder": "json.Decoder.UseNumber",
      "rawInput": "{\"revision\":9007199254740993,\"value\":1.00,\"negativeZero\":-0}",
      "goOutput": "{\"negativeZero\":-0,\"revision\":9007199254740993,\"value\":1.00}"
    },
    {
      "id": "utf8-and-control-escapes",
      "entryDecoder": "json.Decoder.UseNumber",
