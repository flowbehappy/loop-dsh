{
  "name": "@pingkai/loop-dsh",
  "version": "0.2.0",
  "description": "Trusted DeepSeek Harness Web and Desktop bridge for an operator-bound Loop connection",
  "type": "module",
  "main": "host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./host-service": "./host-service.mjs",
    "./host-worksite": "./host-worksite.mjs",
    "./host-collaboration": "./host-collaboration.mjs",
    "./host-collaboration-ui-journal": "./host-collaboration-ui-journal.mjs",
    "./host-models": "./host-models.mjs",
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client.js"
    },
    "./remote": {
      "types": "./remote.d.ts",
      "default": "./remote.mjs"
    },
    "./sync": "./sync.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./host-loop-skills": "./host-loop-skills.mjs",
    "./managed-config": "./managed-config.mjs",
    "./managed-actions": "./managed-native-actions.mjs"
  },
  "files": [
    "host.mjs",
    "host-actions-core.mjs",
    "host-service.mjs",
    "host-worksite.mjs",
    "worksite-origin.mjs",
    "host-collaboration.mjs",
    "collaboration-task-schema.mjs",
    "host-collaboration-ui-journal.mjs",
    "host-default-model.mjs",
    "host-loop-skills.mjs",
    "host-models.mjs",
    "model-identity.mjs",
    "model-identity.d.mts",
    "host-runtime.mjs",
    "host-human-task.mjs",
    "managed-skill.mjs",
    "host-protocol.mjs",
    "binding-store.mjs",
    "remote.mjs",
    "remote.d.ts",
    "client.js",
    "client/index.d.ts",
    "wire.mjs",
    "flavor",
    "sync.mjs",
    "sync/index.js",
    "sync/gate.js",
    "sync/label.js",
    "sync/map.js",
    "sync/scope.js",
    "sync/config.js",
    "cordis.patch.yml",
    "README.md",
    "artifact.sha256",
    "skills/loop-proxy-harness/SKILL.md",
    "skills/loop-proxy-harness/references/",
    "private-path.mjs",
    "private-path.ps1",
    "managed-native-actions.mjs",
    "backend/dist",
    "managed-config.mjs"
  ],
  "license": "Proprietary",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-telemetry": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs && npm run test:client && npm run test:client:ui",
    "test:client": "node --experimental-strip-types --test --test-concurrency=1 client/ui/test/*.test.ts",
    "test:client:ui": "vitest run --config client/vitest.config.mjs",
    "check": "node --check private-path.mjs && node --check managed-config.mjs && node --check managed-actions.mjs && node --check host.mjs && node --check wire.mjs && node --check host-actions-core.mjs && node --check host-worksite.mjs && node --check worksite-origin.mjs && node --check host-collaboration.mjs && node --check host-collaboration-ui-journal.mjs && node --check host-default-model.mjs && node --check host-loop-skills.mjs && node --check host-service.mjs && node --check host-models.mjs && node --check host-runtime.mjs && node --check managed-skill.mjs && node --check binding-store.mjs && node --check remote.mjs && node --check client.js && npm run check:backend",
    "build:client": "node client/build.mjs",
    "test:backend": "node backend/build.mjs && node --test test/native-*.test.mjs",
    "check:backend": "tsc -p backend",
    "build:backend": "node backend/build.mjs",
    "build:native": "node build-native.mjs",
    "test:native:runtime": "node --test test/native-dsh-runtime.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-file-drag": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@shikijs/langs": "^4.4.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "esbuild": "0.28.2",
    "immer": "^10.1.1",
    "jsdom": "^29.1.1",
    "katex": "^0.18.7",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "16.31.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "zustand": "~4.5.7"
  },
  "dependencies": {
    "@libp2p/utils": "7.4.5",
    "@libp2p/yamux": "8.0.7",
    "koffi": "3.3.8",
    "ws": "8.22.2"
  }
}
